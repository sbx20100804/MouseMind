<Window x:Class="MouseMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MouseMind · Prism" Height="820" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource CanvasGradient}">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#70090A0F" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="17,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource PrimaryBrush}">
                        <Path Data="M7,5 L11,5 C13.2,5 15,6.8 15,9 L15,13 C15,15.2 13.2,17 11,17 L9,17 C6.8,17 5,15.2 5,13 L5,9 C5,6.8 6.8,5 9,5 Z M10,5 L10,9"
                              Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="14" Height="14"/>
                    </Border>
                    <TextBlock Text="MouseMind" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0"/>
                    <Border Background="#25213E" CornerRadius="5" Padding="7,3" Margin="9,0,0,0"><TextBlock Text="PRISM · ALPHA 0.3" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#BEB6FF"/></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" ToolTip="最小化" Click="MinimizeButton_Click">
                        <Path Data="M4,8 L12,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="最大化" Click="MaximizeButton_Click">
                        <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="关闭" Click="CloseButton_Click">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,22,16,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel Margin="6,0,6,24">
                        <TextBlock Text="CONTROL CENTER" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock Text="更安静、更聪明地控制 Windows" Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="OverviewNav" Style="{StaticResource ActiveNavButton}" Tag="Overview" Click="Navigation_Click" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal"><Path Data="M3,3 H9 V9 H3 Z M11,3 H17 V7 H11 Z M11,9 H17 V17 H11 Z M3,11 H9 V17 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="概览" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="ProfilesNav" Style="{StaticResource NavButton}" Tag="Profiles" Click="Navigation_Click" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal"><Path Data="M4,4 H16 V8 H4 Z M4,11 H16 V16 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="应用配置" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Tag="Activity" Click="Navigation_Click" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal"><Path Data="M3,10 H6 L8,5 L11,15 L13,10 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="活动记录" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><Path Data="M10,3 A2,2 0 0 1 12,5 L12,6 A5,5 0 0 1 14,8 L15,8 A2,2 0 0 1 17,10 A2,2 0 0 1 15,12 L14,12 A5,5 0 0 1 12,14 L12,15 A2,2 0 0 1 10,17 A2,2 0 0 1 8,15 L8,14 A5,5 0 0 1 6,12 L5,12 A2,2 0 0 1 3,10 A2,2 0 0 1 5,8 L6,8 A5,5 0 0 1 8,6 L8,5 A2,2 0 0 1 10,3 Z M10,8 A2,2 0 1 0 10,12 A2,2 0 1 0 10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#161923" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="11" Padding="13">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="30" Height="30"><Ellipse Fill="#1E392F"/><Ellipse x:Name="SidebarLiveDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/></Grid>
                            <StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="监听服务" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="SidebarStatusText" Text="正在运行" Style="{StaticResource Caption}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                            <CheckBox Grid.Column="2" x:Name="SidebarMonitorSwitch" Style="{StaticResource Switch}" IsChecked="True" Click="SidebarMonitorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main surface -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="32,23,32,0">
                    <StackPanel><TextBlock x:Name="PageHeader" Text="概览" Style="{StaticResource PageTitle}"/><TextBlock x:Name="PageDescription" Text="你的鼠标工作流，正在安静运行。" Style="{StaticResource Caption}" Margin="1,6,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="#172721" CornerRadius="9" BorderBrush="#244ED6B1" BorderThickness="1" Padding="11,8" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="MonitorText" Text="监听已开启" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel></Border>
                        <Button x:Name="MonitorButton" Content="暂停监听" Style="{StaticResource SecondaryButton}" Padding="13,8" Click="MonitorButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="32,6,32,28">
                    <!-- Overview -->
                    <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="26" Margin="0,0,0,16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><Border Background="#29244B" CornerRadius="6" Padding="8,4"><TextBlock Text="LIVE CONTEXT" FontFamily="{StaticResource MonoFont}" Foreground="#C3BCFF" FontSize="9"/></Border></StackPanel>
                                        <TextBlock Text="MouseMind 正在为你工作" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                        <TextBlock Text="当前应用与配置会自动匹配，侧键动作保持低延迟响应。" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                            <Button Content="管理应用配置" Style="{StaticResource PrimaryButton}" Tag="Profiles" Click="Navigation_Click"/>
                                            <Button Content="查看活动记录" Style="{StaticResource SecondaryButton}" Tag="Activity" Click="Navigation_Click" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="210" Height="150" Margin="28,0,6,0">
                                        <Ellipse Width="140" Height="140" Fill="#167C6CF2"/>
                                        <Ellipse x:Name="SignalOrbit" Width="132" Height="132" Stroke="#4A8172F3" StrokeThickness="1"
                                                 StrokeDashArray="2,10" StrokeStartLineCap="Round"/>
                                        <Ellipse x:Name="SignalOrbitReverse" Width="98" Height="98" Stroke="#344ED6B1" StrokeThickness="1"
                                                 StrokeDashArray="1,7" StrokeStartLineCap="Round"/>
                                        <Border x:Name="SignalCore" Width="62" Height="86" CornerRadius="30" Background="#242A38" BorderBrush="#50FFFFFF" BorderThickness="1">
                                            <Grid><Path Data="M31,12 L31,39" Stroke="#BFB6FF" StrokeThickness="2"/><Ellipse Width="7" Height="13" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,15,0,0"/><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Bottom" Margin="0,0,0,14"/></Grid>
                                        </Border>
                                        <TextBlock Text="INPUT SIGNAL" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#817E99" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="当前应用" Style="{StaticResource Caption}"/><TextBlock x:Name="DashboardAppText" Text="等待鼠标事件…" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="FOREGROUND PROCESS" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="9" Margin="0,9,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="激活配置" Style="{StaticResource Caption}"/><TextBlock x:Name="DashboardProfileText" Text="载入中…" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="ACTIVE PROFILE" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="9" Margin="0,9,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="本次会话" Style="{StaticResource Caption}"/><TextBlock x:Name="SessionActionCountText" Text="0 次动作" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="LOCAL · PRIVATE" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource SuccessBrush}" FontSize="9" Margin="0,9,0,0"/></StackPanel></Border>
                            </Grid>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><Button Content="查看全部" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Right" Tag="Activity" Click="Navigation_Click"/></Grid>
                                        <ListBox Grid.Row="1" x:Name="DashboardActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,14,0,0" Height="160" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="快速开始" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择一个配置，再通过侧键测试真实动作。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,18"/>
                                        <Button Content="打开配置中心" Style="{StaticResource PrimaryButton}" Tag="Profiles" Click="Navigation_Click" HorizontalAlignment="Stretch"/>
                                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,18"/>
                                        <TextBlock Text="PRISM DESIGN SYSTEM" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="9"/>
                                        <TextBlock Text="克制的深色层次、清晰焦点与低干扰反馈。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Profiles -->
                    <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="5,3,5,14"><TextBlock Text="应用配置" Style="{StaticResource SectionTitle}"/><TextBlock Text="AUTO MATCH" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/></Grid>
                                <ListBox Grid.Row="1" x:Name="ProfileList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Border Background="#171A24" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Background="{Binding Accent}" CornerRadius="3"/>
                                            <StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding MappingSummary}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Content="＋  新建应用配置" Style="{StaticResource SecondaryButton}" Click="AddProfile_Click" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid><StackPanel><TextBlock x:Name="ProfileTitle" Text="浏览与阅读" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProfileSubtitle" Text="当前匹配：chrome" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="启用配置" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><CheckBox x:Name="ProfileEnabled" Style="{StaticResource Switch}" IsChecked="True" Checked="ProfileEnabled_Changed" Unchecked="ProfileEnabled_Changed"/></StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#151923" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,21,0,18">
                                    <Grid><StackPanel><TextBlock Text="最近识别的前台应用" Style="{StaticResource Caption}"/><TextBlock x:Name="ForegroundAppText" Text="等待鼠标事件…" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#292444" CornerRadius="7" Padding="9,6"><TextBlock Text="CONTEXT" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#C5BEFF"/></Border></Grid>
                                </Border>
                                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid><TextBlock Text="动作映射" Style="{StaticResource SectionTitle}"/><Button Content="＋ 添加动作" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Right" Click="AddMapping_Click"/></Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><ItemsControl x:Name="MappingList">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#171A24" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Background="#24283A" CornerRadius="7" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="{Binding Trigger}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#D2CDFF"/></Border>
                                            <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Action}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                                            <Button Grid.Column="2" Content="测试" Style="{StaticResource SecondaryButton}" Padding="12,7" Tag="{Binding}" Click="TestAction_Click"/>
                                        </Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl></ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Activity -->
                    <Border x:Name="ActivityPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid><StackPanel><TextBlock Text="实时活动" Style="{StaticResource SectionTitle}"/><TextBlock Text="鼠标事件、配置匹配和动作执行都保留在本机。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button Content="清空记录" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,7" Click="ClearLog_Click"/></Grid>
                            <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#171A24" CornerRadius="10" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="运行状态" Style="{StaticResource Caption}"/><TextBlock Text="实时监听" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="#171A24" CornerRadius="10" Padding="14" Margin="7,0"><StackPanel><TextBlock Text="日志上限" Style="{StaticResource Caption}"/><TextBlock Text="50 条" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#171A24" CornerRadius="10" Padding="14" Margin="7,0,0,0"><StackPanel><TextBlock Text="数据位置" Style="{StaticResource Caption}"/><TextBlock Text="仅本机" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#0D1017" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <ListBox x:Name="EventLog" Background="Transparent" BorderThickness="0" Foreground="#B6BDCE" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="780" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="常规" Style="{StaticResource SectionTitle}"/><TextBlock Text="控制 MouseMind 的启动与后台行为。" Style="{StaticResource Caption}" Margin="0,6,0,18"/>
                                <Grid Margin="0,0,0,18"><TextBlock Text="启动时自动开启监听" VerticalAlignment="Center"/><CheckBox IsChecked="True" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                                <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="关闭后驻留系统托盘"/><TextBlock Text="将在后续里程碑中启用" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><CheckBox IsEnabled="False" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                                <Grid><TextBlock Text="启动后最小化" VerticalAlignment="Center"/><CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="Prism 使用曜石深色主题与低干扰动效。" Style="{StaticResource Caption}" Margin="0,6,0,18"/>
                                <Grid><StackPanel><TextBlock Text="主题"/><TextBlock Text="Obsidian Glass" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#282443" CornerRadius="7" Padding="11,7"><TextBlock Text="PRISM" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#C8C1FF"/></Border></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><Grid><StackPanel><TextBlock Text="关于" Style="{StaticResource SectionTitle}"/><TextBlock Text="MouseMind Alpha 0.3 · Prism" Margin="0,12,0,0"/><TextBlock Text="A calmer, smarter way to control Windows." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#172721" CornerRadius="8" Padding="10,7"><TextBlock Text="OPEN SOURCE" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource SuccessBrush}"/></Border></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Premium action toast: one quiet, consistent feedback surface. -->
        <Border x:Name="ActionToastHost" Grid.RowSpan="2" Panel.ZIndex="30" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,24" Width="340"
                Background="#F21A1E29" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="13" Padding="15">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.42"/></Border.Effect>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" VerticalAlignment="Top">
                    <Ellipse x:Name="ToastIconBackground" Fill="#243ED2A9"/>
                    <Path x:Name="ToastIcon" Data="M7,15 L12,20 L22,9" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Grid><TextBlock x:Name="ToastTitle" Text="动作完成" FontWeight="SemiBold"/><TextBlock Text="MOUSEMIND" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/></Grid>
                    <TextBlock x:Name="ToastMessage" Text="快捷键已发送到当前应用。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
