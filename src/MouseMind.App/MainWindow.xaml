<Window x:Class="MouseMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MouseMind" Height="760" Width="1220" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowFallbackBrush}"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#8A0B0E14" ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Integrated title bar -->
        <Border Grid.Row="0" Background="#32111419" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,7,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="8">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2997FF"/><GradientStop Color="#40C8FF" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Path Data="M8,7 C8,5.9 8.9,5 10,5 H14 C16.8,5 19,7.2 19,10 V15 C19,17.8 16.8,20 14,20 H12 C9.2,20 7,17.8 7,15 V10 C7,8.8 7.4,7.8 8,7 Z M13,5 V10"
                              Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" Stretch="Uniform" Width="17" Height="17"/>
                    </Border>
                    <TextBlock Text="MouseMind" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0"/>
                </StackPanel>
                <TextBlock Text="控制中心" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" ToolTip="最小化" Click="MinimizeButton_Click" AutomationProperties.Name="最小化">
                        <Path Data="M4,8 L12,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="最大化" Click="MaximizeButton_Click" AutomationProperties.Name="最大化">
                        <Rectangle Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="关闭" Click="CloseButton_Click" AutomationProperties.Name="关闭">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Translucent navigation pane -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0">
                <Grid Margin="14,22,14,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="7,0,7,23">
                        <TextBlock Text="工作空间" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="OverviewNav" Style="{StaticResource ActiveNavButton}" Tag="Overview" Click="Navigation_Click" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal"><Path Data="M3,3 H9 V9 H3 Z M11,3 H17 V7 H11 Z M11,9 H17 V17 H11 Z M3,11 H9 V17 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="概览" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="ProfilesNav" Style="{StaticResource NavButton}" Tag="Profiles" Click="Navigation_Click" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal"><Path Data="M4,4 H16 V8 H4 Z M4,11 H16 V16 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="应用配置" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Tag="Activity" Click="Navigation_Click" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal"><Path Data="M3,10 H6 L8,5 L11,15 L13,10 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="活动记录" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigation_Click">
                            <StackPanel Orientation="Horizontal"><Path Data="M10,3 A2,2 0 0 1 12,5 L12,6 A5,5 0 0 1 14,8 L15,8 A2,2 0 0 1 17,10 A2,2 0 0 1 15,12 L14,12 A5,5 0 0 1 12,14 L12,15 A2,2 0 0 1 10,17 A2,2 0 0 1 8,15 L8,14 A5,5 0 0 1 6,12 L5,12 A2,2 0 0 1 3,10 A2,2 0 0 1 5,8 L6,8 A5,5 0 0 1 8,6 L8,5 A2,2 0 0 1 10,3 Z M10,8 A2,2 0 1 0 10,12 A2,2 0 1 0 10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.15" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="设置" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource InsetGlass}" Padding="12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="31" Height="31"><Ellipse Fill="#1E30D158"/><Ellipse x:Name="SidebarLiveDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/></Grid>
                            <StackPanel Grid.Column="1" Margin="9,0"><TextBlock Text="鼠标监听" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="SidebarStatusText" Text="已开启" Style="{StaticResource Caption}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                            <CheckBox Grid.Column="2" x:Name="SidebarMonitorSwitch" Style="{StaticResource Switch}" IsChecked="True" Click="SidebarMonitorSwitch_Click" VerticalAlignment="Center" AutomationProperties.Name="鼠标监听"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="36,25,32,0">
                    <StackPanel><TextBlock x:Name="PageHeader" Text="概览" Style="{StaticResource PageTitle}"/><TextBlock x:Name="PageDescription" Text="你的鼠标，已经准备好了。" Style="{StaticResource Caption}" FontSize="13" Margin="1,6,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="#1430D158" CornerRadius="10" BorderBrush="#2030D158" BorderThickness="1" Padding="11,8" Margin="0,0,9,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="MonitorText" Text="正在监听" Foreground="#9BF0AE" FontWeight="SemiBold" FontSize="12"/></StackPanel></Border>
                        <Button x:Name="MonitorButton" Content="暂停" Style="{StaticResource SecondaryButton}" Padding="14,8" Click="MonitorButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="36,5,32,28">
                    <!-- Overview -->
                    <Grid x:Name="OverviewPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="24" MinHeight="150">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                    <!-- Context Lens stays compact and functional. -->
                                    <Grid Width="76" Height="76" VerticalAlignment="Center">
                                        <Ellipse Fill="#12FFFFFF" Stroke="#30FFFFFF" StrokeThickness="1"/>
                                        <Ellipse x:Name="SignalOrbit" Width="63" Height="63" Stroke="#34FFFFFF" StrokeThickness="1"/>
                                        <Ellipse x:Name="SignalOrbitReverse" Width="49" Height="49" Stroke="#30006EDC" StrokeThickness="1"/>
                                        <Border x:Name="SignalCore" Width="28" Height="43" CornerRadius="14" Background="#42FFFFFF" BorderBrush="#6AFFFFFF" BorderThickness="1">
                                            <Grid><Path Data="M14,6 L14,19" Stroke="#EFFFFFFF" StrokeThickness="1.4"/><Ellipse Width="4" Height="8" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,8,0,0"/></Grid>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashboardAppText" Text="等待鼠标事件…" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="DashboardProfileText" Text="浏览与阅读" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DashboardMappingSummaryText" Text="侧键 1：主要动作  ·  侧键 2：辅助动作" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="管理配置" Style="{StaticResource PrimaryButton}" Tag="Profiles" Click="Navigation_Click" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><StackPanel><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><TextBlock Text="动作结果与输入诊断" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="SessionActionCountText" Text="0 次动作" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="查看全部" Style="{StaticResource SecondaryButton}" Padding="12,7" Tag="Activity" Click="Navigation_Click"/></StackPanel></Grid>
                                        <Grid Grid.Row="1" Margin="0,18,0,12">
                                            <ListBox x:Name="DashboardActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Top">
                                                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="0,9"><TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel x:Name="DashboardActivityHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#10FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                                    <Path Data="M5,12 H8 L10,7 L13,17 L15,12 H19" Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="23" Height="23" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="等待下一次鼠标动作" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                                <TextBlock Text="触发侧键后，结果会出现在这里" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="最近 50 条记录 · 仅保存在这台电脑上" Style="{StaticResource Caption}" FontSize="11"/>
                                    </Grid>

                                    <Border Grid.Column="1" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0" Padding="24">
                                        <StackPanel>
                                            <TextBlock Text="快速切换" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="应用会自动匹配，也可以从这里管理。" Style="{StaticResource Caption}" Margin="0,4,0,18"/>

                                            <ItemsControl x:Name="DashboardProfilesList">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Style="{StaticResource NavButton}" Tag="{Binding}" Click="QuickProfile_Click" Margin="-10,0,-10,4" AutomationProperties.Name="{Binding Name}">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF"><Grid><Ellipse Width="10" Height="10" Fill="{Binding Accent}"/><Ellipse Width="18" Height="18" Stroke="#24FFFFFF" StrokeThickness="1"/></Grid></Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding MappingSummary}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                            <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                    </Grid>

                    <!-- Profiles -->
                    <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0" Padding="13">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="我的配置" Style="{StaticResource SectionTitle}" Margin="7,5,0,15"/>
                                <ListBox Grid.Row="1" x:Name="ProfileList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfileList_SelectionChanged">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#10FFFFFF"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#22FFFFFF"/><Setter TargetName="Row" Property="BorderBrush" Value="#24FFFFFF"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{Binding Accent}" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding MappingSummary}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/></Grid>
                                    </Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Content="添加配置" Style="{StaticResource SecondaryButton}" Click="AddProfile_Click" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid><StackPanel><TextBlock x:Name="ProfileTitle" Text="浏览与阅读" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ProfileSubtitle" Text="匹配 chrome" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="启用" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><CheckBox x:Name="ProfileEnabled" Style="{StaticResource Switch}" IsChecked="True" Checked="ProfileEnabled_Changed" Unchecked="ProfileEnabled_Changed" AutomationProperties.Name="启用配置"/></StackPanel></Grid>
                                <Border Grid.Row="1" Style="{StaticResource InsetGlass}" Margin="0,21,0,18"><Grid><StackPanel><TextBlock Text="最近识别的应用" Style="{StaticResource Caption}"/><TextBlock x:Name="ForegroundAppText" Text="等待鼠标事件…" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Ellipse HorizontalAlignment="Right" VerticalAlignment="Center" Width="9" Height="9" Fill="{StaticResource PrimaryBrush}"/></Grid></Border>
                                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="侧键动作" Style="{StaticResource SectionTitle}"/><Button Content="添加动作" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Right" Click="AddMapping_Click"/></Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><ItemsControl x:Name="MappingList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InsetGlass}" Margin="0,0,0,8" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#16FFFFFF" CornerRadius="8" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="{Binding Trigger}" FontSize="11"/></Border><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Action}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="测试" Style="{StaticResource SecondaryButton}" Padding="12,7" Tag="{Binding}" Click="TestAction_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Activity -->
                    <Border x:Name="ActivityPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid><StackPanel><TextBlock Text="活动记录" Style="{StaticResource SectionTitle}"/><TextBlock Text="动作、匹配和输入诊断都留在本机。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Button Content="清空" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,7" Click="ClearLog_Click"/></Grid>
                            <Border Grid.Row="1" Style="{StaticResource InsetGlass}" Margin="0,21,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="监听" Style="{StaticResource Caption}"/><TextBlock Text="运行中" Foreground="#9BF0AE" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="保留数量" Style="{StaticResource Caption}"/><TextBlock Text="50 条" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="存储" Style="{StaticResource Caption}"/><TextBlock Text="仅本机" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border>
                            <Border Grid.Row="2" Background="#30101217" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="13" Padding="14"><ListBox x:Name="EventLog" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/></Border>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="780" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,13"><StackPanel><TextBlock Text="常规" Style="{StaticResource SectionTitle}"/><TextBlock Text="启动与后台行为" Style="{StaticResource Caption}" Margin="0,5,0,18"/>
                                <Grid Margin="0,0,0,19"><StackPanel><TextBlock Text="自动开始监听"/><TextBlock Text="打开 MouseMind 后立即接管侧键" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><CheckBox IsChecked="True" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="自动开始监听"/></Grid>
                                <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,18"/>
                                <Grid Margin="0,0,0,19"><StackPanel><TextBlock Text="驻留通知区域"/><TextBlock Text="此功能将在下一阶段开放" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><CheckBox IsEnabled="False" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="驻留通知区域"/></Grid>
                                <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,18"/>
                                <Grid><StackPanel><TextBlock Text="启动后最小化"/><TextBlock Text="安静地在后台运行" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="启动后最小化"/></Grid>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,13"><Grid><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="Liquid Glass" Margin="0,12,0,0"/><TextBlock Text="桌面亚克力、柔和层次与系统蓝强调色" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8"><TextBlock Text="自动" FontWeight="SemiBold"/></Border></Grid></Border>
                            <Border Style="{StaticResource Card}"><Grid><StackPanel><TextBlock Text="关于" Style="{StaticResource SectionTitle}"/><TextBlock Text="MouseMind Alpha 0.3" Margin="0,12,0,0"/><TextBlock Text="A calmer, smarter way to control Windows." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1530D158" CornerRadius="10" Padding="11,7"><TextBlock Text="开源" Foreground="#9BF0AE" FontWeight="SemiBold"/></Border></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Translucent action feedback -->
        <Border x:Name="ActionToastHost" Grid.RowSpan="2" Panel.ZIndex="30" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,24" Width="344"
                Background="#D9343740" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="16" Padding="15"
                Effect="{StaticResource FloatingShadow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid Width="31" Height="31" VerticalAlignment="Top"><Ellipse x:Name="ToastIconBackground" Fill="#243ED2A9"/><Path x:Name="ToastIcon" Data="M7,15 L12,20 L22,9" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/></Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock x:Name="ToastTitle" Text="动作完成" FontWeight="SemiBold"/><TextBlock x:Name="ToastMessage" Text="快捷键已发送到当前应用。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
